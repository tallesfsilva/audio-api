# ─── Copy this to .env and fill in the values ──────────────────────────────────
# Used by docker-compose.yml (production stack)

# ── PostgreSQL ──────────────────────────────────────────────────────────────────
POSTGRES_USER=whisper
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=whisper_saas
POSTGRES_EXTERNAL_PORT=5432        # host port (change if 5432 is taken)

# ── Redis ───────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_strong_redis_password
REDIS_EXTERNAL_PORT=6379           # host port (change if 6379 is taken)

# ── API ─────────────────────────────────────────────────────────────────────────
API_EXTERNAL_PORT=3000

# ── JWT (generate with: openssl rand -hex 32) ───────────────────────────────────
JWT_ACCESS_SECRET=replace_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_another_openssl_rand_hex_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Storage ──────────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local               # local | s3
STORAGE_LOCAL_MAX_SIZE_MB=500

# S3 (only when STORAGE_DRIVER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ── Queue ────────────────────────────────────────────────────────────────────────
QUEUE_NAME=transcription
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
QUEUE_BACKOFF_DELAY_MS=5000

# ── Rate limiting ─────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── CORS ──────────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://yourdomain.com
