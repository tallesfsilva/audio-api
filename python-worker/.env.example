# Redis — must match docker-compose values
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_DB=0

# Queue — must match Node API QUEUE_NAME
QUEUE_NAME=transcription

# Worker
WORKER_CONCURRENCY=2          # parallel jobs per worker instance

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_BASE_PATH=/app/storage

# Whisper
WHISPER_MODEL_CACHE=/app/models
WHISPER_DEFAULT_MODEL=base
WHISPER_COMPUTE_TYPE=int8     # int8 (CPU fast), float16 (GPU), float32 (CPU precise)
WHISPER_DEVICE=cpu             # cpu | cuda
